# Public site URL (no trailing slash). Used for canonical URLs, sitemaps, OG images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project settings (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — server-only, NEVER prefix with NEXT_PUBLIC_, never send to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Toss Payments (developers.tosspayments.com) — use the *_test_ keys while developing.
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# Private Supabase Storage bucket that holds high-resolution originals.
PRIVATE_STORAGE_BUCKET=poster-originals

# Comma-separated list of email addresses allowed to sign in to /admin.
ADMIN_EMAIL=admin@example.com
