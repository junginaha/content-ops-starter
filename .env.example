# PostgreSQL connection string used by the app and by `npm run db:migrate` / `npm run db:seed`.
DATABASE_URL=postgres://jinjoo:jinjoo@localhost:5432/jinjoo

# AI provider credentials. When AI_API_KEY or AI_MODEL is missing, the app automatically falls
# back to the deterministic local redaction engine (src/lib/ai/local-redaction.ts).
# The default AI integration targets the Anthropic Messages API (https://api.anthropic.com/v1/messages).
# Set AI_MODEL to a current Claude model id, e.g. claude-sonnet-5.
AI_API_KEY=
AI_MODEL=

# Password for the single admin account used at /admin. Use a long, random value.
ADMIN_PASSWORD=

# Secret used to sign/derive server-side session material. Use a long, random value
# (e.g. `openssl rand -hex 32`).
SESSION_SECRET=
